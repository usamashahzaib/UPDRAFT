# Public hostname whose DNS A/AAAA record points to this server.
DOMAIN=api.example.com
ACME_EMAIL=admin@example.com

POSTGRES_DB=updraft
POSTGRES_USER=updraft
POSTGRES_PASSWORD=

JWT_ISSUER=project-updraft
JWT_AUDIENCE=project-updraft-client
# Use a long, random value (at least 32 bytes); never commit the real key.
JWT_SIGNING_KEY=

# Shared secret used only between the backend and the authoritative match server.
# Generate a separate long random value; never commit the deployed value.
GAME_SERVER_API_KEY=

# Photon region remains "eu" until target-market latency evidence approves a change.
FUSION_REGION=eu

# Public URL used in account-deletion verification links.
SUPPORT_PUBLIC_BASE_URL=https://api.example.com

# Optional production SMTP relay. The free Proton mailbox cannot be used as a
# generic SMTP submission relay. Leave these blank to use the persistent outbox
# for local/test inspection only; that is not production email delivery.
EMAIL_FROM=playhotdrop@proton.me
SMTP_HOST=
SMTP_PORT=587
SMTP_ENABLE_SSL=true
SMTP_USERNAME=
SMTP_PASSWORD=
