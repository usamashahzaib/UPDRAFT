# Unity generated
ProjectHotdrop/Library/
ProjectHotdrop/Temp/
ProjectHotdrop/Obj/
ProjectHotdrop/Build/
ProjectHotdrop/Builds/
ProjectHotdrop/Logs/
ProjectHotdrop/UserSettings/
ProjectHotdrop/MemoryCaptures/
ProjectHotdrop/*.csproj
ProjectHotdrop/*.sln
ProjectHotdrop/.vs/

# Ad-hoc batchmode compile/test scratch output (always regenerable)
ProjectHotdrop/unity_*.log
ProjectHotdrop/*.xml
ProjectHotdrop/PerformanceTestRunInfo.json

# com.unity.test-framework.performance writes these into Resources by
# default, which would otherwise ship inside every player build.
ProjectHotdrop/Assets/Resources/PerformanceTestRunInfo.json
ProjectHotdrop/Assets/Resources/PerformanceTestRunInfo.json.meta
ProjectHotdrop/Assets/Resources/PerformanceTestRunSettings.json
ProjectHotdrop/Assets/Resources/PerformanceTestRunSettings.json.meta

# Backend
Backend/**/bin/
Backend/**/obj/
Backend/**/*.user
Backend/TestOutput/
Backend/**/TestResults/

# OS / editor
.DS_Store
Thumbs.db
.vscode/

# Photon App ID lives only in this generated settings asset; keep it out of
# source control (spec section 20). Supply it via HOTDROP_FUSION_APP_ID or the
# local asset; see docs/NETWORK.md.
ProjectHotdrop/Assets/Photon/Fusion/Resources/PhotonAppSettings.asset
ProjectHotdrop/Assets/Photon/Fusion/Resources/PhotonAppSettings.asset.meta

# Local test/build outputs
ProjectHotdrop/TestResults/
ProjectHotdrop/*.log
ProjectHotdrop/.utmp/

# Secrets - never commit
Oracle keys/
deploy/.env
*.pem
*.key
