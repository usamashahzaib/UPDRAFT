{
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Database=updraft;Username=updraft;Password=CHANGE_ME_LOCAL_DEV_ONLY"
  },
  "Jwt": {
    "Issuer": "project-updraft",
    "Audience": "project-updraft-client"
  },
  "Features": {
    "MatchmakingEnabled": true,
    "PurchasesEnabled": false
  },
  "Allocator": {
    "FusionRegion": "eu",
    "MaxConcurrentMatches": 4
  },
  "Matchmaking": {
    "RatingWindowBase": 150,
    "RatingWindowExpandAfterSeconds": 20,
    "RatingWindowExpandStep": 50,
    "RatingWindowExpandIntervalSeconds": 10,
    "RatingWindowMax": 350,
    "BotFillWaitSeconds": 45,
    "PollIntervalSeconds": 2
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
